# The system-mode unit, shipped by the `qshd` package but NOT enabled by
# default: installing a package must not open a port on a machine whose
# administrator never asked for one. `systemctl enable --now qshd` does that.
#
# The personal unit is a different file with the same name, installed under
# /usr/lib/systemd/user/qshd.service: it runs as one person, without the
# privileged helper and without --system.
[Unit]
Description=qshd — a resilient terminal daemon (system mode)
After=network.target

[Service]
ExecStart=/usr/bin/qshd serve --system --port 60022
Restart=on-failure
RestartSec=2

# Do NOT switch the following on, however much they look like free hardening.
# This daemon starts login shells for other people, so whatever sandbox it
# runs in is inherited by every one of those shells:
#
#   ProtectHome=yes        -- hides /home, and the shells then fail to start
#   PrivateTmp=yes         -- gives the sessions a /tmp of their own, where
#                             people cannot find their own files
#   NoNewPrivileges=yes    -- breaks sudo inside a session
#   CapabilityBoundingSet= -- inherited down to the user's own programs: sudo,
#                             su, passwd and mount inside a session would be
#                             left without their privileges
#
# The fifth trap is in the restart policy above, and it is not a negation:
# Restart=on-failure does NOT restart the service after the process dies of
# SIGTERM, SIGINT, SIGHUP or SIGPIPE, because systemd counts those as a clean
# exit. The policy is deliberate -- sessions do not survive a restart anyway --
# but an administrator who sees "the service did not come back after kill"
# should find the reason written here rather than have to derive it.

[Install]
WantedBy=multi-user.target
