+    #[test]
+    fn test_preun_dependencies_have_real_script_phase() {
+        let mut table = Table::new();
+        table.insert(
+            "/usr/bin/getent".to_string(),
+            Value::String(" * ".to_string()),
+        );
+        table.insert(
+            "/usr/sbin/useradd".to_string(),
+            Value::String("".to_string()),
+        );
+        assert_eq!(
+            Config::table_to_preun_dependencies(&table).unwrap(),
+            vec![
+                Dependency::script_preun("/usr/bin/getent"),
+                Dependency::script_preun("/usr/sbin/useradd")
+            ]
+        );
+        for dependency in Config::table_to_preun_dependencies(&table).unwrap() {
+            assert!(dependency.flags.contains(rpm::DependencyFlags::SCRIPT_PREUN));
+            assert_ne!(dependency.flags, rpm::DependencyFlags::ANY);
+            assert!(dependency.version.is_empty());
+        }
+    }
+
+    #[test]
