+#[cfg(all(test, target_os = "linux"))]
+mod ldd_child_reaping_tests {
+    use super::*;
+
+    fn child(script: &str) -> Child {
+        Command::new("/bin/sh")
+            .args(["-c", script])
+            .stdout(Stdio::piped())
+            .spawn()
+            .unwrap()
+    }
+
+    fn assert_reaped(pid: u32) {
+        assert!(
+            !Path::new(&format!("/proc/{pid}")).exists(),
+            "owned child was not reaped"
+        );
+    }
+
+    #[test]
+    fn valid_output_reaps_exit_zero() {
+        let process = child("printf 'libfixture.so.1 => /fixture/libfixture.so.1 (0x0)\\n'");
+        let pid = process.id();
+        let output = read_and_wait_ldd(process, Path::new("fixture"), |stdout, output| {
+            stdout.read_to_string(output)
+        })
+        .unwrap();
+        assert!(output.starts_with("libfixture.so.1"));
+        assert_reaped(pid);
+    }
+
+    #[test]
+    fn valid_output_preserves_ignored_nonzero_status() {
+        let process = child("printf 'libfixture.so.1\\n'; exit 7");
+        let pid = process.id();
+        let output = read_and_wait_ldd(process, Path::new("fixture"), |stdout, output| {
+            stdout.read_to_string(output)
+        })
+        .unwrap();
+        assert_eq!(output, "libfixture.so.1\n");
+        assert_reaped(pid);
+    }
+
+    #[test]
+    fn invalid_utf8_retains_read_error_after_reaping() {
+        let process = child("printf '\\377'");
+        let pid = process.id();
+        let result = read_and_wait_ldd(process, Path::new("fixture"), |stdout, output| {
+            stdout.read_to_string(output)
+        });
+        assert!(matches!(
+            result,
+            Err(AutoReqError::LddOutputReadError(_, _))
+        ));
+        assert_reaped(pid);
+    }
+
+    #[test]
+    fn early_read_error_closes_pipe_before_waiting_for_finite_producer() {
+        let process = child("printf x; exec /usr/bin/head -c 16777216 /dev/zero");
+        let pid = process.id();
+        let result = read_and_wait_ldd(process, Path::new("fixture"), |stdout, _| {
+            let mut byte = [0];
+            stdout.read_exact(&mut byte)?;
+            assert_eq!(byte, [b'x']);
+            Err(io::Error::new(
+                io::ErrorKind::Other,
+                "injected early read error",
+            ))
+        });
+        assert!(matches!(
+            result,
+            Err(AutoReqError::LddOutputReadError(_, _))
+        ));
+        assert_reaped(pid);
+    }
+}
