+fn read_and_wait_ldd(
+    mut process: Child,
+    path: &Path,
+    read_stdout: impl FnOnce(&mut ChildStdout, &mut String) -> io::Result<usize>,
+) -> Result<String, AutoReqError> {
+    let mut stdout = process.stdout.take().expect("piped ldd stdout");
+    let mut output = String::new();
+    let read_result = read_stdout(&mut stdout, &mut output);
+    // Close before waiting: a failed read must not leave a blocked producer.
+    drop(stdout);
+    let wait_result = process.wait();
+    read_result.map_err(|error| AutoReqError::LddOutputReadError(path.to_path_buf(), error))?;
+    // ldd exit status remains deliberately ignored, as in the pinned version.
+    wait_result.map_err(|error| AutoReqError::ProcessError(OsString::from("ldd"), error))?;
+    Ok(output)
 }
 
