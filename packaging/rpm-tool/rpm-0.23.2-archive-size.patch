+#[cfg(test)]
+mod archive_size_tests {
+    use super::*;
+
+    #[test]
+    fn archive_size_width_and_rebuild_preserve_value() {
+        for size in [0, u64::from(u32::MAX), u64::from(u32::MAX) + 1] {
+            let header = SignatureHeaderBuilder::new()
+                .format(RpmFormat::V4)
+                .set_archive_size(size)
+                .build()
+                .unwrap();
+            let rebuilt = SignatureHeaderBuilder::from_existing(&header)
+                .unwrap()
+                .clear_signatures()
+                .build()
+                .unwrap();
+            for header in [&header, &rebuilt] {
+                if size <= u64::from(u32::MAX) {
+                    assert_eq!(
+                        header
+                            .get_entry_data_as_u32(IndexSignatureTag::RPMSIGTAG_PAYLOADSIZE)
+                            .unwrap(),
+                        size as u32
+                    );
+                    assert!(
+                        header
+                            .get_entry_data_as_u64(IndexSignatureTag::RPMSIGTAG_LONGARCHIVESIZE)
+                            .is_err()
+                    );
+                } else {
+                    assert_eq!(
+                        header
+                            .get_entry_data_as_u64(IndexSignatureTag::RPMSIGTAG_LONGARCHIVESIZE)
+                            .unwrap(),
+                        size
+                    );
+                    assert!(
+                        header
+                            .get_entry_data_as_u32(IndexSignatureTag::RPMSIGTAG_PAYLOADSIZE)
+                            .is_err()
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn v6_does_not_emit_legacy_archive_size() {
+        let header = SignatureHeaderBuilder::new()
+            .format(RpmFormat::V6)
+            .set_archive_size(u64::MAX)
+            .build()
+            .unwrap();
+        assert!(
+            header
+                .get_entry_data_as_u32(IndexSignatureTag::RPMSIGTAG_PAYLOADSIZE)
+                .is_err()
+        );
+        assert!(
+            header
+                .get_entry_data_as_u64(IndexSignatureTag::RPMSIGTAG_LONGARCHIVESIZE)
+                .is_err()
+        );
+    }
+}
