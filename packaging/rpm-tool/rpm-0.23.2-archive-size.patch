+        for size in [0, 1, 2, 3, 1024, 1025] {
+            let mut builder = PackageBuilder::new("size-test", "1", "MIT", "noarch", "size");
+            builder.using_config(BuildConfig::v4().compression(CompressionType::None));
+            builder
+                .with_file_contents(vec![b'x'; size], FileOptions::new("/a"))
+                .unwrap();
+            builder
+                .with_file_contents(vec![b'y'; 7], FileOptions::new("/odd-name"))
+                .unwrap();
+            let pkg = builder.build().unwrap();
+            let declared = pkg
+                .metadata
+                .signature
+                .get_entry_data_as_u32(IndexSignatureTag::RPMSIGTAG_PAYLOADSIZE)
+                .unwrap();
+            assert_eq!(u64::from(declared), pkg.payload.len() as u64);
+            assert!(pkg.payload.windows(10).any(|bytes| bytes == b"TRAILER!!!"));
+            assert!(declared as usize > size + 7);
+        }
+    }
