#!/bin/sh
# Fedora SELinux pair lifecycle: RPM count is the sole routing authority.
set -e

if [ "$#" -ne 1 ]; then
    echo QSHD_RPM_COUNT_REFUSED >&2
    exit 1
fi
case "$1" in
    ''|*[!0-9]*|0[0-9]*)
        echo QSHD_RPM_COUNT_REFUSED >&2
        exit 1
        ;;
esac

# Policy/state erase completed in final preun while its helper assets existed.
exit 0
